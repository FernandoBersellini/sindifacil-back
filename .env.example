# Copie para .env e preencha. O .env não vai para o git.

# Senha do usuário "postgres" do banco sindifacil_db (localhost:5432).
DB_PASSWORD=

# Segredo para assinar os tokens JWT. Gere um valor aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Administrador inicial. Só é criado na subida do app se não houver nenhum
# ADMIN ativo na tabela users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Porta do servidor (padrão: 5555).
# PORT=5555
